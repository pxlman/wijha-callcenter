generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100) @unique
  description String? @db.Text

  clientProjects           ClientProject[]
  projectCallDetailRecords ProjectCallDetailRecord[]

  @@map("project")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phoneNumber  String?  @unique @map("phone_number") @db.VarChar(20)
  name         String?  @db.VarChar(50)
  role         String  @db.VarChar(50)
  otp          String?  @db.VarChar(6)
  otpExpiry    DateTime? @map("otp_expiry")
  jwtToken     String?  @map("jwt_token") @db.Text
  profileImage Bytes?   @map("profile_image")
  profileMime  String?  @map("profile_mime") @db.VarChar(20)

  userSessions       UserSession[]
  callDetailRecords  CallDetailRecord[]
  clientAssignments  Client[]       @relation("ClientAgent")

  @@map("user")
}

model UserSession {
  agentId   Int      @map("agent_id")
  firstBeat DateTime @map("first_beat")
  lastBeat  DateTime @map("last_beat")
  duration  Int      @default(0) @map("duration")

  agent          User             @relation(fields: [agentId], references: [id])
  activeSessions ActiveSession[]

  @@id([agentId, firstBeat])
  @@map("user_session")
}

model ActiveSession {
  agentId   Int      @map("agent_id")
  firstBeat DateTime @map("first_beat")

  session UserSession @relation(fields: [agentId, firstBeat], references: [agentId, firstBeat], onDelete: Cascade)

  @@id([agentId])
  @@map("active_session")
}

model Client {
  id         BigInt    @id @default(autoincrement())
  name       String?   @db.VarChar(50)
  type       String    @db.VarChar(10)       // "OWNER" | "LEAD" | "BOTH"
  nextDialAt DateTime? @map("next_dial_at")

  agentId Int? @map("agent_id")
  agent   User? @relation("ClientAgent", fields: [agentId], references: [id])

  numbers           Number[]
  clientInfo        ClientInfo[]
  callDetailRecords CallDetailRecord[]
  clientProjects    ClientProject[]

  @@map("client")
}

model Number {
  number   String @db.VarChar(20) @unique
  clientId BigInt @map("client_id")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([number])
  @@map("numbers")
}

model ClientInfo {
  key      String @db.VarChar(60)
  clientId BigInt @map("client_id")
  value    String @db.VarChar(60)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([key, clientId])
  @@map("client_info")
}

model CallDetailRecord {
  id         BigInt   @id @default(autoincrement())
  clientId   BigInt?  @map("client_id")
  agentId    Int?     @map("agent_id")
  status     String?  @db.VarChar(50)
  time       DateTime
  duration   Int?
  agentNotes String?  @map("agent_notes") @db.Text

  client       Client?                      @relation(fields: [clientId], references: [id])
  agent        User?                        @relation(fields: [agentId], references: [id])
  projectLinks ProjectCallDetailRecord[]

  @@map("call_detail_record")
}

model ProjectCallDetailRecord {
  projectId          Int   @map("project_id")
  callDetailRecordId BigInt @map("call_detail_record_id")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  callRecord CallDetailRecord @relation(fields: [callDetailRecordId], references: [id])

  @@id([projectId, callDetailRecordId])
  @@map("project_call_detail_record")
}

model ClientProject {
  clientId     BigInt    @map("client_id")
  projectId    Int       @map("project_id")
  status       String?   @default("dial") @db.VarChar(50)
  lastDialedAt DateTime? @map("last_dialed_at")
  attemptCount Int?      @default(0) @map("attempt_count")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([clientId, projectId])
  @@map("client_project")
}
